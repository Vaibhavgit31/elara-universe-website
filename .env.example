# Elara Universe Publishers website — every environment variable the site reads.
# Copy to .env.local for development. Never commit real values. Without a variable the matching
# feature runs in MOCK MODE (see DEPLOY.md and BUILD_LOG.md "Mock-mode features").

# --- Contact form (Phase 1) ---------------------------------------------------------------
# Web3Forms access key (https://web3forms.com, free). Without it the contact page shows the
# email and WhatsApp buttons instead of sending.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Supabase: teacher and admin accounts, access requests, doubts, saved tests (Step F) ---
# Project URL and the publishable (anon) key: Supabase dashboard → Project Settings → API Keys.
# Both are safe in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret (service role) key: SERVER ONLY. Used to create accounts and to write requests, doubts
# and AI counters. Never prefix with NEXT_PUBLIC_, never put in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct Postgres connection string (dashboard → Connect → Session pooler), used only
# by `npm run db:migrate` to apply supabase/migrations/. Without it, apply SETUP-SUPABASE.md by hand.
SUPABASE_DB_URL=
# Comma-separated emails that are admins (see /admin). Everyone else who signs in is a teacher.
ADMIN_EMAILS=
# Public site URL, used in password-reset and invite links (https://elarauniversepublications.com).
NEXT_PUBLIC_SITE_URL=

# --- xAI Grok: Elu chatbot (Step H) and Test Maker (Step I) ---------------------------------
# API key from https://console.x.ai. Both XAI_API_KEY and XAI_MODEL must be set; without either,
# the chatbot and the Test Maker run in mock mode (answers and sample questions from the site's
# own content, no AI). Server only: never prefix with NEXT_PUBLIC_.
XAI_API_KEY=
# Model id from https://docs.x.ai/developers/models. No default is assumed by the code. Suggestion
# (check the page first): grok-4.3, the lowest-priced current chat model on xAI's price list.
XAI_MODEL=

# --- Vercel (Step K, optional) ---------------------------------------------------------------
# Only for deploying from this machine with the Vercel CLI; never read by the site itself.
VERCEL_TOKEN=
